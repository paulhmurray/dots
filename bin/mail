#!/usr/bin/env bash
# Show and hide the mail client, and keep the unread count fresh.
#
# Relay (the Flatpak app.relay.Relay) lives on the special:mail scratchpad, so
# it runs in the background and never takes one of the numbered workspaces.
# Same shape as bin/music, for the same reasons. It has no tray icon and only
# syncs, notifies and fires reminders while its window exists, which is why
# hyprland.lua runs `mail ensure` at login.
set -euo pipefail

APP='app.relay.Relay'
CLASS='^(app\.relay\.Relay)$'
DOTS="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/dots/mail-account"

running() { flatpak ps --columns=application 2>/dev/null | grep -qx "$APP"; }

# Start Relay if it is not running. Any arguments (a mailto: URL) go to the
# new instance; when it is already running, `forward` hands them to it instead.
ensure() {
    running && return 0
    setsid flatpak run "$APP" "$@" >/dev/null 2>&1 &
    for _ in $(seq 1 40); do
        sleep 0.5
        running && return 0
    done
    echo "mail: relay did not start" >&2
    return 1
}

# Relay is single-instance: a second `flatpak run` with a URL passes it to the
# running window and exits.
forward() { [ $# -gt 0 ] && flatpak run "$APP" "$@" >/dev/null 2>&1 || true; }

# Relay's window address, empty until the window exists. ensure only waits for
# the process, so callers that need the window poll this briefly.
addr() { hyprctl clients -j 2>/dev/null | jq -r 'first(.[] | select(.class == "app.relay.Relay")) | .address // empty'; }
wait_addr() {
    local a
    for _ in $(seq 1 40); do
        a=$(addr); [ -n "$a" ] && { echo "$a"; return 0; }
        sleep 0.25
    done
    return 1
}
ws_of() { hyprctl clients -j 2>/dev/null | jq -r --arg a "$1" '.[] | select(.address == $a) | .workspace.name'; }

# Put the window back on the scratchpad the way the window rule first placed
# it. Needed after `pane` has pulled it out: the rule only runs when a window
# opens, so moving it back by hand has to redo the float and size as well.
park() {
    local a=$1
    [ "$(ws_of "$a")" = "special:mail" ] && return 0
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"special:mail\", follow = false })" >/dev/null 2>&1 || true
    hyprctl dispatch "hl.dsp.window.float({ window = \"address:$a\", action = \"enable\" })" >/dev/null 2>&1 || true
    hyprctl dispatch "hl.dsp.window.resize({ window = \"address:$a\", x = 1400, y = 900, relative = false })" >/dev/null 2>&1 || true
    read -r mw mh < <(hyprctl monitors -j | jq -r 'first(.[] | select(.focused)) | "\(.width/.scale|floor) \(.height/.scale|floor)"')
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$a\", x = $(( (mw-1400)/2 )), y = $(( (mh-900)/2 )), relative = false })" >/dev/null 2>&1 || true
}

case "${1:-}" in
    ensure) ensure ;;

    # Show or hide it over whatever you are doing. The window rule opens it
    # silently, so this is the only thing that ever brings it into view.
    # Always bring it into view, never hide it. This is what the launcher and
    # the desktop entry use: picking Relay from a launcher, or clicking a
    # mailto: link, must show it, whereas Super+E toggles. A URL argument is
    # passed on so the compose window opens for the link that was clicked.
    show)
        shift
        if running; then forward "$@"; else ensure "$@"; fi
        if command -v hyprctl >/dev/null; then
            a=$(wait_addr || true); [ -n "$a" ] && park "$a"
            shown=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].specialWorkspace.name // ""')
            [ "$shown" = "special:mail" ] || hyprctl dispatch 'hl.dsp.workspace.toggle_special("mail")' >/dev/null 2>&1 || true
            hyprctl dispatch "hl.dsp.focus({ window = [[class:$CLASS]] })" >/dev/null 2>&1 || true
        fi
        ;;

    window)
        ensure
        if command -v hyprctl >/dev/null; then
            a=$(wait_addr || true); [ -n "$a" ] && park "$a"
            hyprctl dispatch 'hl.dsp.workspace.toggle_special("mail")' >/dev/null 2>&1 || true
        fi
        ;;

    # Relay as an ordinary tile on the current workspace, for when there is
    # more to do than delete one message. Super+E puts it back on the
    # scratchpad; this is Super+Shift+E. Already a tile somewhere: go to it.
    pane)
        ensure
        command -v hyprctl >/dev/null || exit 0
        a=$(wait_addr) || { echo "mail: no relay window" >&2; exit 1; }
        if [ "$(ws_of "$a")" = "special:mail" ]; then
            shown=$(hyprctl monitors -j 2>/dev/null | jq -r 'first(.[] | select(.focused)) | .specialWorkspace.name // ""')
            [ "$shown" = "special:mail" ] && hyprctl dispatch 'hl.dsp.workspace.toggle_special("mail")' >/dev/null 2>&1
            ws=$(hyprctl activeworkspace -j | jq -r .id)
            hyprctl dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"$ws\", follow = false })" >/dev/null 2>&1 || true
            hyprctl dispatch "hl.dsp.window.float({ window = \"address:$a\", action = \"disable\" })" >/dev/null 2>&1 || true
        fi
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$a\" })" >/dev/null 2>&1 || true
        ;;

    count)  "$DOTS/bin/mail-count" ;;

    # One-time setup. Printed rather than automated: the app password has to be
    # created in a browser, and this file is the one thing here holding a
    # credential.
    setup)
        mkdir -p "$(dirname "$CONF")"
        if [ -f "$CONF" ]; then
            echo "$CONF already exists; edit it by hand to change the account."
            exit 0
        fi
        cat > "$CONF" <<'EOF'
# One section per account. The bar shows the total; hovering breaks it down.
# Mode 0600 — this file holds app passwords and is never committed.

[main]
host=imap.gmail.com
user=CHANGEME@gmail.com
pass=CHANGEME
folder=INBOX

# A second account: uncomment and fill in. Each needs its own app password.
#[old]
#host=imap.gmail.com
#user=CHANGEME@gmail.com
#pass=CHANGEME
#folder=INBOX
EOF
        chmod 600 "$CONF"
        cat <<EOF
Wrote $CONF (mode 0600).

Now:
  1. Turn on 2-step verification on your Google account if it is not already.
  2. Create an app password at https://myaccount.google.com/apppasswords
     Google will show 16 characters in four groups.
  3. Put your address and that app password into the file above.
  4. Check it with:  mail count

This is separate from the Google sign-in Relay keeps in the keyring. It exists
so the unread count works even when Relay is closed, and so a Relay upgrade
cannot break it.
EOF
        ;;

    *)
        cat <<'EOF'
usage: mail <command>

  window     show/hide the mail window over your work
  pane       pull it onto this workspace as an ordinary tile (Super+E puts it back)
  show [url] bring it into view (never hides) — used by the launcher and mailto:
  ensure     start Relay if it is not running
  count      check unread now and update the bar
  setup      create the credentials file and explain the app password
EOF
        exit 2 ;;
esac
