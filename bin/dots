#!/usr/bin/env bash
# Keeps this machine and the dots repo in step. See README.
set -euo pipefail

# Resolve through the symlink in ~/.local/bin back to the repo it lives in.
DOTS="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
APPLIED="${XDG_CACHE_HOME:-$HOME/.cache}/dots/applied"
export DOTS
# shellcheck source=../lib/dots-status.sh
source "$DOTS/lib/dots-status.sh"

usage() {
    cat <<'EOF'
usage: dots <command>

  status           what differs between this machine and the repo
  status --json    the same, as JSON
  status --write   write the JSON to ~/.cache/dots/status.json

  sync             pull, then do only what the changed files require
  add <pkg>        upgrade, install, record in a list, commit and push
  upgrade          yay -Syu, then say whether a reboot is needed
  auth             set this machine up to push (one time, needs a token)
  relink           remake the ~/.local/bin and ~ symlinks, drop dead ones

status only reads: no sudo, no fetch, no pacman transaction.
sync, add and upgrade are interactive by design — an upgrade always stops at
its [Y/n] so you can see a kernel bump coming.
EOF
}

# Anything that changes the answer refreshes the cached answer. Without this
# the bar goes on showing what was true before you acted — and the moment just
# after you have acted is exactly when you look at it. The pacman path unit
# hides this when a package was really installed, but not when sync pulls
# nothing or add records something already present.
refresh_status() { cmd_status --write >/dev/null 2>&1 || true; }

# --- upgrade ---------------------------------------------------------------
# yay rather than pacman: pacman -Syu never touches AUR packages, so the AUR
# half of the machine would silently rot. Interactive on purpose — no
# --noconfirm here, unlike install.sh, which installs a list you already chose.
cmd_upgrade() {
    local before after
    before=$(dots_reboot_watch)
    echo "==> Full system upgrade (repo + AUR)"
    # Guarded: bin/dots runs under set -e, and yay exits non-zero both when a
    # package fails to build and when you simply answer n at its [Y/n]. Left
    # bare, either one killed the whole command at this line — which mattered
    # most inside sync, where the pull had already happened and install.sh had
    # not yet run.
    if ! yay -Syu; then
        echo >&2
        echo "    Upgrade did not complete — declined at the prompt, or a" >&2
        echo "    package failed. Nothing else was changed." >&2
        return 1
    fi
    after=$(dots_reboot_watch)
    if [ "$before" != "$after" ]; then
        echo
        echo "    Reboot needed: the running system no longer matches what is on disk."
        diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") \
            | grep '^>' | sed 's/^> /      /'
    fi
    refresh_status
}

# --- auth ------------------------------------------------------------------
# Reading this repo is anonymous; only pushing needs a credential. Printed
# rather than automated: the token has to be created in a browser, and this
# repo should not be in the business of handling credentials on your behalf.
auth_help() {
    cat <<'EOF'

To push from this machine, once:

  1. Create a token at https://github.com/settings/personal-access-tokens
     Repository access: only  paulhmurray/dots
     Permissions:       Contents -> Read and write

  2. dots auth

  3. Push once. Git asks for a username and password: give your GitHub
     username, and paste the token as the password. It is saved and you
     will not be asked again.

Scope it to this repository. An account-wide token, or an SSH key, would give
whoever obtained it far more than a public dotfiles repo.
EOF
}

cmd_auth() {
    cd "$DOTS"
    local url
    url=$(git remote get-url origin 2>/dev/null || true)
    case "$url" in
        https://*) ;;
        *)  echo "origin is '$url', not https — run install.sh first." >&2
            return 1 ;;
    esac

    # Repo-local on purpose: a global credential.helper would apply to every
    # repo on the machine, including work ones.
    if [ -z "$(git config --local --get credential.helper || true)" ]; then
        git config --local credential.helper store
        echo "==> credential.helper=store, for this repo only"
    else
        echo "==> credential helper already set: $(git config --local --get credential.helper)"
    fi

    if [ -f "$HOME/.git-credentials" ] && grep -q 'github\.com' "$HOME/.git-credentials" 2>/dev/null; then
        echo "==> A github.com credential is already stored; push should just work."
    else
        echo "    No github.com credential stored yet."
        auth_help
    fi
}

# --- sync ------------------------------------------------------------------
mark_applied() {
    mkdir -p "$(dirname "$APPLIED")" && echo "$1" > "$APPLIED"
}

relink() {
    local f name target
    mkdir -p "$HOME/.local/bin" "$HOME/.local/share/applications"

    for f in "$DOTS"/bin/*; do
        ln -sfn "$f" "$HOME/.local/bin/$(basename "$f")"
    done
    for f in "$DOTS"/desktop/*.desktop; do
        [ -e "$f" ] || continue
        ln -sfn "$f" "$HOME/.local/share/applications/$(basename "$f")"
    done
    # Home files are linked only where nothing real is in the way: clobbering
    # someone's actual ~/.bashrc is install.sh's decision to make, with its
    # keep-a-copy behaviour, not a background sync's.
    for f in "$DOTS"/home/.[!.]*; do
        [ -e "$f" ] || continue
        name=$(basename "$f")
        if [ -e "$HOME/$name" ] && [ ! -L "$HOME/$name" ]; then
            echo "    left your own $name alone (run install.sh to replace it)"
        else
            ln -sfn "$f" "$HOME/$name"
        fi
    done

    # Links this repo made whose target has since gone. Scoped to links that
    # point into $DOTS so nothing else on the machine is touched.
    for f in "$HOME"/.local/bin/* "$HOME"/.local/share/applications/*; do
        [ -L "$f" ] || continue
        target=$(readlink "$f")
        case "$target" in
            "$DOTS"/*) [ -e "$f" ] || { rm -f "$f"; echo "    removed stale $(basename "$f")"; } ;;
        esac
    done
}

cmd_sync() {
    cd "$DOTS"

    # Derived files block a fast-forward whenever two machines sit on different
    # themes, which is the normal case here. They are regenerated below.
    git checkout -- "${DOTS_GENERATED[@]}" 2>/dev/null || true

    # lazy-lock.json changes whenever nvim updates a plugin, so on any machine
    # that is not the one you drive it blocks every pull. Both machines are
    # meant to run identical plugin versions, and the repo is the authority on
    # what those are, so take the repo's copy — but only when it is the sole
    # thing in the way, and say so rather than doing it quietly.
    local lock=dotfiles/nvim/lazy-lock.json
    if [ "$(dots_dirty_all)" = "$lock" ]; then
        echo "==> Discarding local $lock (taking the repo's plugin versions)"
        git checkout -- "$lock" 2>/dev/null || true
    fi

    # Everything still modified, self-writing files included: git refuses a
    # fast-forward over any of them, whatever the reason they changed.
    local blocking
    blocking=$(dots_dirty_all)
    if [ -n "$blocking" ]; then
        echo "Uncommitted changes would be overwritten by a pull:" >&2
        sed 's/^/    /' <<<"$blocking" >&2
        if grep -qxF dotfiles/nvim/lazy-lock.json <<<"$blocking"; then
            echo >&2
            echo "    lazy-lock.json is nvim's plugin lockfile; it changes whenever" >&2
            echo "    Lazy updates a plugin. Commit it to keep this machine's plugin" >&2
            echo "    versions, or discard it to take the other machine's:" >&2
            echo "        git -C ~/dots checkout -- dotfiles/nvim/lazy-lock.json" >&2
        fi
        echo >&2
        echo "Commit or discard them, then run dots sync again." >&2
        return 1
    fi

    local before after changed baseline
    before=$(git rev-parse HEAD)
    echo "==> Pulling"
    git pull --ff-only
    after=$(git rev-parse HEAD)

    # The commit this machine last finished applying, which is not the same as
    # the commit it has checked out. A sync that pulled and then failed part
    # way through leaves those two apart, and measuring from HEAD-before-pull
    # would call the leftover work "already up to date" forever. Missing or
    # unrecognised marker falls back to the old behaviour.
    baseline=$(cat "$APPLIED" 2>/dev/null || true)
    git cat-file -e "${baseline}^{commit}" 2>/dev/null || baseline="$before"

    if [ "$baseline" = "$after" ]; then
        echo "==> Already up to date"
        # The theme files were just discarded; put them back before leaving.
        "$DOTS/theme/apply.sh" >/dev/null 2>&1 || true
        mark_applied "$after"
        refresh_status
        return 0
    fi

    changed=$(git diff --name-only "$baseline" "$after")
    [ "$baseline" = "$before" ] || echo "==> Finishing work left over from an earlier sync"
    echo "==> $(wc -l <<<"$changed") file(s) changed"

    local needs_install=0 needs_theme=0 needs_reload=0 needs_link=0
    while read -r f; do
        case "$f" in
            packages/*|hosts/*|scripts/*|systemd/*|install.sh) needs_install=1 ;;
            theme/*)    needs_theme=1 ;;
            dotfiles/*) needs_reload=1 ;;
            bin/*|home/*|desktop/*) needs_link=1 ;;
        esac
    done <<<"$changed"

    # install.sh runs pacman -S against whatever the database currently holds.
    # On a stale database that is either a 404 or, worse, a partial upgrade, so
    # the upgrade is a prerequisite of this branch and only this branch.
    if [ "$needs_install" = 1 ]; then
        if ! cmd_upgrade; then
            # Without this the retry is blind: the pull has already advanced
            # HEAD, so a sync measuring from HEAD-before-pull sees no change
            # and reports "already up to date" over a machine that never
            # installed anything.
            mark_applied "$baseline"
            echo >&2
            echo "    The pull succeeded but nothing was installed, so this machine" >&2
            echo "    now has the new configuration without the packages it needs." >&2
            echo "    Run 'dots sync' again to pick up exactly where this stopped." >&2
            return 1
        fi
        echo "==> Running install.sh"
        "$DOTS/install.sh"
    fi

    # bin/, home/ and desktop/ reach the machine as symlinks that install.sh
    # makes, so until they are remade a pull changes nothing. That failure is
    # nastier than it sounds: a new command is simply absent from PATH, which
    # looks like the command being broken rather than like a sync that did not
    # finish, and a removed one leaves a link pointing at nothing. install.sh
    # already relinks, so this only runs when it did not.
    if [ "$needs_link" = 1 ] && [ "$needs_install" = 0 ]; then
        echo "==> Relinking commands"
        relink
    fi

    # Bare, so the machine keeps its own theme. A palette edit upstream reaches
    # this machine through here.
    if [ "$needs_theme" = 1 ] || [ "$needs_install" = 1 ]; then
        echo "==> Applying theme"
        "$DOTS/theme/apply.sh"
    elif [ "$needs_reload" = 1 ]; then
        echo "==> Reloading Hyprland and quickshell"
        hyprctl reload >/dev/null 2>&1 || true
        pkill quickshell 2>/dev/null || true
        setsid quickshell >/dev/null 2>&1 &
        "$DOTS/theme/apply.sh" >/dev/null 2>&1 || true
    else
        "$DOTS/theme/apply.sh" >/dev/null 2>&1 || true
    fi

    mark_applied "$after"
    refresh_status
    echo "==> Done"
}

# --- add -------------------------------------------------------------------
# install.sh reads these lists with an unquoted $(cat), so a file that does not
# end in a newline would glue the new name onto the last one and hand pacman a
# package that does not exist.
append_pkg() {
    local file="$1" pkg="$2"
    if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then
        printf '\n' >> "$file"
    fi
    printf '%s\n' "$pkg" >> "$file"
}

cmd_add() {
    local list="" pkgs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --desktop|--system|--dev|--aur) list="${1#--}" ;;
            --host) list=host ;;
            -*) echo "dots add: unknown option $1" >&2; return 2 ;;
            *)  pkgs+=("$1") ;;
        esac
        shift
    done
    [ ${#pkgs[@]} -gt 0 ] || {
        echo "usage: dots add <package>... [--dev|--system|--desktop|--aur|--host]" >&2
        return 2
    }

    cd "$DOTS"

    # Sort into: already written down, from a repo, from the AUR. Resolve every
    # name before installing anything, so one typo cannot leave half the list
    # recorded and the other half not.
    local declared native=() aur=() skipped=()
    declared=$(dots_declared)
    local p
    for p in "${pkgs[@]}"; do
        if grep -qxF "$p" <<<"$declared"; then
            skipped+=("$p")
        elif pacman -Si "$p" >/dev/null 2>&1; then
            native+=("$p")
        elif yay -Si "$p" >/dev/null 2>&1; then
            aur+=("$p")
        else
            echo "dots add: no package called '$p' in the repos or the AUR" >&2
            return 1
        fi
    done

    [ ${#skipped[@]} -gt 0 ] && echo "==> Already declared, skipping: ${skipped[*]}"
    if [ ${#native[@]} -eq 0 ] && [ ${#aur[@]} -eq 0 ]; then
        echo "Nothing to do."
        return 0
    fi
    [ ${#aur[@]} -gt 0 ] && echo "==> From the AUR: ${aur[*]}"

    if [ ${#native[@]} -gt 0 ] && [ -z "$list" ]; then
        echo "Which list should ${native[*]} go in?"
        local opts=(desktop system dev host) choice
        select choice in "${opts[@]}"; do
            [ -n "${choice:-}" ] && { list="$choice"; break; }
        done
    fi

    local file=""
    if [ ${#native[@]} -gt 0 ]; then
        case "$list" in
            host) file="$DOTS/hosts/$(dots_host)/packages.txt" ;;
            aur)  echo "dots add: --aur is for AUR packages; ${native[*]} are in a repo" >&2
                  return 2 ;;
            *)    file="$DOTS/packages/$list.txt" ;;
        esac
        [ -f "$file" ] || { echo "dots add: no such list: $file" >&2; return 1; }
    fi

    # Anything already on the machine needs no install, and therefore no
    # upgrade: the stale-database problem only bites when pacman has to fetch
    # something. Recording drift you already have is free.
    local to_install=()
    for p in "${native[@]}" "${aur[@]}"; do
        pacman -Qq "$p" >/dev/null 2>&1 || to_install+=("$p")
    done

    if [ ${#to_install[@]} -gt 0 ]; then
        cmd_upgrade
        local want_native=() want_aur=()
        for p in "${native[@]}"; do
            printf '%s\n' "${to_install[@]}" | grep -qxF "$p" && want_native+=("$p")
        done
        for p in "${aur[@]}"; do
            printf '%s\n' "${to_install[@]}" | grep -qxF "$p" && want_aur+=("$p")
        done
        echo "==> Installing: ${to_install[*]}"
        [ ${#want_native[@]} -gt 0 ] && sudo pacman -S --needed "${want_native[@]}"
        [ ${#want_aur[@]} -gt 0 ] && yay -S --needed "${want_aur[@]}"
    else
        echo "==> All already installed; recording them only"
    fi

    local changed=()
    for p in "${native[@]}"; do append_pkg "$file" "$p"; done
    [ ${#native[@]} -gt 0 ] && { git add "$file"; changed+=("${file#"$DOTS"/}"); }
    if [ ${#aur[@]} -gt 0 ]; then
        for p in "${aur[@]}"; do append_pkg "$DOTS/packages/aur.txt" "$p"; done
        git add "$DOTS/packages/aur.txt"
        changed+=(packages/aur.txt)
    fi
    echo "==> Recorded in ${changed[*]}"

    git commit -q -m "packages: add ${native[*]} ${aur[*]}"
    if git push -q 2>/dev/null; then
        echo "==> Pushed"
    else
        echo "    Committed, but the push failed. 'dots status' will show this" >&2
        echo "    machine as ahead until it lands." >&2
        if [ -z "$(git config --local --get credential.helper || true)" ]; then
            echo "    This machine has no push credential set up yet." >&2
            auth_help >&2
        fi
    fi
    refresh_status
}

cmd_status() {
    local json=0 write=0 fetch=0 stale=false
    for arg in "$@"; do
        case "$arg" in
            --json)  json=1 ;;
            --write) write=1 ;;
            --fetch) fetch=1 ;;
            *) echo "dots status: unknown option $arg" >&2; return 2 ;;
        esac
    done

    # Only the timer asks for this. It is a read of a public repo over https,
    # so it needs no credentials and cannot prompt; a laptop that is simply
    # offline reports stale rather than failing.
    # Bounded on purpose. A dead gateway or a captive portal does not refuse
    # the connection, it swallows it: an unroutable address hangs for well over
    # a minute, which on the laptop would mean a stuck service every half hour.
    # Failing fast and reporting stale is the useful answer.
    if [ "$fetch" = 1 ]; then
        timeout 20 env GIT_TERMINAL_PROMPT=0 git -C "$DOTS" fetch -q 2>/dev/null \
            || stale=true
    fi

    local behind ahead drift aur_drift dirty
    IFS=$'\t' read -r behind ahead < <(dots_behind_ahead)
    drift=$(dots_drift)
    aur_drift=$(dots_aur_drift)
    dirty=$(dots_dirty)

    if [ "$json" = 1 ] || [ "$write" = 1 ]; then
        local doc
        doc=$(jq -n \
            --argjson behind "$behind" \
            --argjson ahead "$ahead" \
            --arg     theme "$(dots_theme)" \
            --arg     host "$(dots_host)" \
            --argjson dirty "$(printf '%s' "$dirty" | jq -R -s 'split("\n") | map(select(length > 0))')" \
            --argjson drift "$(printf '%s' "$drift" | jq -R -s 'split("\n") | map(select(length > 0))')" \
            --argjson aur_drift "$(printf '%s' "$aur_drift" | jq -R -s 'split("\n") | map(select(length > 0))')" \
            --arg     checked_at "$(date -Is)" \
            --argjson stale "$stale" \
            '{host: $host, theme: $theme, behind: $behind, ahead: $ahead,
              dirty: $dirty, drift: $drift, aur_drift: $aur_drift,
              checked_at: $checked_at, stale: $stale,
              clean: (($behind + $ahead) == 0 and ($dirty | length) == 0
                      and ($drift | length) == 0 and ($aur_drift | length) == 0)}')
        if [ "$write" = 1 ]; then
            mkdir -p "$DOTS_CACHE"
            printf '%s\n' "$doc" > "$DOTS_CACHE/status.json"
        fi
        [ "$json" = 1 ] && printf '%s\n' "$doc"
        return 0
    fi

    # Human output. Silence is the goal: every line below is something to act on.
    local said=0
    [ "$behind" -gt 0 ] && { echo "behind    $behind commit(s) — dots sync"; said=1; }
    [ "$ahead"  -gt 0 ] && { echo "ahead     $ahead commit(s) not pushed"; said=1; }
    if [ -n "$dirty" ]; then
        echo "dirty     $(wc -l <<<"$dirty") uncommitted file(s)"
        sed 's/^/            /' <<<"$dirty"
        said=1
    fi
    if [ -n "$drift" ]; then
        echo "drift     $(wc -l <<<"$drift") package(s) installed but in no list"
        tr '\n' ' ' <<<"$drift" | fold -s -w 64 | sed 's/^/            /'
        said=1
    fi
    if [ -n "$aur_drift" ]; then
        echo "aur       $(wc -l <<<"$aur_drift") AUR package(s) in no list"
        tr '\n' ' ' <<<"$aur_drift" | fold -s -w 64 | sed 's/^/            /'
        said=1
    fi
    [ "$said" = 0 ] && echo "up to date   ($(dots_host), theme $(dots_theme))"
    return 0
}

case "${1:-}" in
    status)  shift; cmd_status "$@" ;;
    sync)    shift; cmd_sync "$@" ;;
    add)     shift; cmd_add "$@" ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    auth)    shift; cmd_auth "$@" ;;
    relink)  shift; echo "==> Relinking commands"; relink ;;
    -h|--help|help|"") usage ;;
    *) echo "dots: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
