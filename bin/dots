#!/usr/bin/env bash
# Keeps this machine and the dots repo in step. See README.
set -euo pipefail

# Resolve through the symlink in ~/.local/bin back to the repo it lives in.
DOTS="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export DOTS
# shellcheck source=../lib/dots-status.sh
source "$DOTS/lib/dots-status.sh"

usage() {
    cat <<'EOF'
usage: dots <command>

  status           what differs between this machine and the repo
  status --json    the same, as JSON
  status --write   write the JSON to ~/.cache/dots/status.json

  sync             pull, then do only what the changed files require
  add <pkg>        upgrade, install, record in a list, commit and push
  upgrade          yay -Syu, then say whether a reboot is needed
  auth             set this machine up to push (one time, needs a token)

status only reads: no sudo, no fetch, no pacman transaction.
sync, add and upgrade are interactive by design — an upgrade always stops at
its [Y/n] so you can see a kernel bump coming.
EOF
}

# --- upgrade ---------------------------------------------------------------
# yay rather than pacman: pacman -Syu never touches AUR packages, so the AUR
# half of the machine would silently rot. Interactive on purpose — no
# --noconfirm here, unlike install.sh, which installs a list you already chose.
cmd_upgrade() {
    local before after
    before=$(dots_reboot_watch)
    echo "==> Full system upgrade (repo + AUR)"
    yay -Syu
    after=$(dots_reboot_watch)
    if [ "$before" != "$after" ]; then
        echo
        echo "    Reboot needed: the running system no longer matches what is on disk."
        diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") \
            | grep '^>' | sed 's/^> /      /'
    fi
}

# --- auth ------------------------------------------------------------------
# Reading this repo is anonymous; only pushing needs a credential. Printed
# rather than automated: the token has to be created in a browser, and this
# repo should not be in the business of handling credentials on your behalf.
auth_help() {
    cat <<'EOF'

To push from this machine, once:

  1. Create a token at https://github.com/settings/personal-access-tokens
     Repository access: only  paulhmurray/dots
     Permissions:       Contents -> Read and write

  2. dots auth

  3. Push once. Git asks for a username and password: give your GitHub
     username, and paste the token as the password. It is saved and you
     will not be asked again.

Scope it to this repository. An account-wide token, or an SSH key, would give
whoever obtained it far more than a public dotfiles repo.
EOF
}

cmd_auth() {
    cd "$DOTS"
    local url
    url=$(git remote get-url origin 2>/dev/null || true)
    case "$url" in
        https://*) ;;
        *)  echo "origin is '$url', not https — run install.sh first." >&2
            return 1 ;;
    esac

    # Repo-local on purpose: a global credential.helper would apply to every
    # repo on the machine, including work ones.
    if [ -z "$(git config --local --get credential.helper || true)" ]; then
        git config --local credential.helper store
        echo "==> credential.helper=store, for this repo only"
    else
        echo "==> credential helper already set: $(git config --local --get credential.helper)"
    fi

    if [ -f "$HOME/.git-credentials" ] && grep -q 'github\.com' "$HOME/.git-credentials" 2>/dev/null; then
        echo "==> A github.com credential is already stored; push should just work."
    else
        echo "    No github.com credential stored yet."
        auth_help
    fi
}

# --- sync ------------------------------------------------------------------
cmd_sync() {
    cd "$DOTS"

    # Derived files block a fast-forward whenever two machines sit on different
    # themes, which is the normal case here. They are regenerated below.
    git checkout -- "${DOTS_GENERATED[@]}" 2>/dev/null || true

    # Everything still modified, self-writing files included: git refuses a
    # fast-forward over any of them, whatever the reason they changed.
    local blocking
    blocking=$(dots_dirty_all)
    if [ -n "$blocking" ]; then
        echo "Uncommitted changes would be overwritten by a pull:" >&2
        sed 's/^/    /' <<<"$blocking" >&2
        if grep -qxF dotfiles/nvim/lazy-lock.json <<<"$blocking"; then
            echo >&2
            echo "    lazy-lock.json is nvim's plugin lockfile; it changes whenever" >&2
            echo "    Lazy updates a plugin. Commit it to keep this machine's plugin" >&2
            echo "    versions, or discard it to take the other machine's:" >&2
            echo "        git -C ~/dots checkout -- dotfiles/nvim/lazy-lock.json" >&2
        fi
        echo >&2
        echo "Commit or discard them, then run dots sync again." >&2
        return 1
    fi

    local before after changed
    before=$(git rev-parse HEAD)
    echo "==> Pulling"
    git pull --ff-only
    after=$(git rev-parse HEAD)

    if [ "$before" = "$after" ]; then
        echo "==> Already up to date"
        # The theme files were just discarded; put them back before leaving.
        "$DOTS/theme/apply.sh" >/dev/null 2>&1 || true
        return 0
    fi

    changed=$(git diff --name-only "$before" "$after")
    echo "==> $(wc -l <<<"$changed") file(s) changed"

    local needs_install=0 needs_theme=0 needs_reload=0
    while read -r f; do
        case "$f" in
            packages/*|hosts/*|scripts/*|systemd/*|install.sh) needs_install=1 ;;
            theme/*)    needs_theme=1 ;;
            dotfiles/*) needs_reload=1 ;;
        esac
    done <<<"$changed"

    # install.sh runs pacman -S against whatever the database currently holds.
    # On a stale database that is either a 404 or, worse, a partial upgrade, so
    # the upgrade is a prerequisite of this branch and only this branch.
    if [ "$needs_install" = 1 ]; then
        cmd_upgrade
        echo "==> Running install.sh"
        "$DOTS/install.sh"
    fi

    # Bare, so the machine keeps its own theme. A palette edit upstream reaches
    # this machine through here.
    if [ "$needs_theme" = 1 ] || [ "$needs_install" = 1 ]; then
        echo "==> Applying theme"
        "$DOTS/theme/apply.sh"
    elif [ "$needs_reload" = 1 ]; then
        echo "==> Reloading Hyprland and quickshell"
        hyprctl reload >/dev/null 2>&1 || true
        pkill quickshell 2>/dev/null || true
        setsid quickshell >/dev/null 2>&1 &
        "$DOTS/theme/apply.sh" >/dev/null 2>&1 || true
    else
        "$DOTS/theme/apply.sh" >/dev/null 2>&1 || true
    fi

    echo "==> Done"
}

# --- add -------------------------------------------------------------------
# install.sh reads these lists with an unquoted $(cat), so a file that does not
# end in a newline would glue the new name onto the last one and hand pacman a
# package that does not exist.
append_pkg() {
    local file="$1" pkg="$2"
    if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then
        printf '\n' >> "$file"
    fi
    printf '%s\n' "$pkg" >> "$file"
}

cmd_add() {
    local pkg="" list=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --desktop|--system|--dev|--aur) list="${1#--}" ;;
            --host) list=host ;;
            -*) echo "dots add: unknown option $1" >&2; return 2 ;;
            *)  pkg="$1" ;;
        esac
        shift
    done
    [ -n "$pkg" ] || { echo "usage: dots add <package> [--dev|--system|--desktop|--aur|--host]" >&2; return 2; }

    cd "$DOTS"

    if grep -qxF "$pkg" <(dots_declared); then
        echo "$pkg is already declared — nothing to do."
        return 0
    fi

    # Where it comes from decides which list it may go in.
    local from_aur=0
    if pacman -Si "$pkg" >/dev/null 2>&1; then
        from_aur=0
    elif yay -Si "$pkg" >/dev/null 2>&1; then
        from_aur=1
        echo "==> $pkg is an AUR package"
        list=aur
    else
        echo "dots add: no package called '$pkg' in the repos or the AUR" >&2
        return 1
    fi

    if [ -z "$list" ]; then
        echo "Which list should $pkg go in?"
        local opts=(desktop system dev host)
        select choice in "${opts[@]}"; do
            [ -n "${choice:-}" ] && { list="$choice"; break; }
        done
    fi

    local file
    case "$list" in
        host) file="$DOTS/hosts/$(dots_host)/packages.txt" ;;
        *)    file="$DOTS/packages/$list.txt" ;;
    esac
    [ -f "$file" ] || { echo "dots add: no such list: $file" >&2; return 1; }

    cmd_upgrade
    echo "==> Installing $pkg"
    if [ "$from_aur" = 1 ]; then
        yay -S --needed "$pkg"
    else
        sudo pacman -S --needed "$pkg"
    fi

    append_pkg "$file" "$pkg"
    echo "==> Recorded in ${file#"$DOTS"/}"

    git add "$file"
    git commit -q -m "packages: add $pkg"
    if git push -q 2>/dev/null; then
        echo "==> Pushed"
    else
        echo "    Committed, but the push failed. 'dots status' will show this" >&2
        echo "    machine as ahead until it lands." >&2
        if [ -z "$(git config --local --get credential.helper || true)" ]; then
            echo "    This machine has no push credential set up yet." >&2
            auth_help >&2
        fi
    fi
}

cmd_status() {
    local json=0 write=0
    for arg in "$@"; do
        case "$arg" in
            --json)  json=1 ;;
            --write) write=1 ;;
            *) echo "dots status: unknown option $arg" >&2; return 2 ;;
        esac
    done

    local behind ahead drift aur_drift dirty
    IFS=$'\t' read -r behind ahead < <(dots_behind_ahead)
    drift=$(dots_drift)
    aur_drift=$(dots_aur_drift)
    dirty=$(dots_dirty)

    if [ "$json" = 1 ] || [ "$write" = 1 ]; then
        local doc
        doc=$(jq -n \
            --argjson behind "$behind" \
            --argjson ahead "$ahead" \
            --arg     theme "$(dots_theme)" \
            --arg     host "$(dots_host)" \
            --argjson dirty "$(printf '%s' "$dirty" | jq -R -s 'split("\n") | map(select(length > 0))')" \
            --argjson drift "$(printf '%s' "$drift" | jq -R -s 'split("\n") | map(select(length > 0))')" \
            --argjson aur_drift "$(printf '%s' "$aur_drift" | jq -R -s 'split("\n") | map(select(length > 0))')" \
            --arg     checked_at "$(date -Is)" \
            '{host: $host, theme: $theme, behind: $behind, ahead: $ahead,
              dirty: $dirty, drift: $drift, aur_drift: $aur_drift,
              checked_at: $checked_at,
              clean: (($behind + $ahead) == 0 and ($dirty | length) == 0
                      and ($drift | length) == 0 and ($aur_drift | length) == 0)}')
        if [ "$write" = 1 ]; then
            mkdir -p "$DOTS_CACHE"
            printf '%s\n' "$doc" > "$DOTS_CACHE/status.json"
        fi
        [ "$json" = 1 ] && printf '%s\n' "$doc"
        return 0
    fi

    # Human output. Silence is the goal: every line below is something to act on.
    local said=0
    [ "$behind" -gt 0 ] && { echo "behind    $behind commit(s) — dots sync"; said=1; }
    [ "$ahead"  -gt 0 ] && { echo "ahead     $ahead commit(s) not pushed"; said=1; }
    if [ -n "$dirty" ]; then
        echo "dirty     $(wc -l <<<"$dirty") uncommitted file(s)"
        sed 's/^/            /' <<<"$dirty"
        said=1
    fi
    if [ -n "$drift" ]; then
        echo "drift     $(wc -l <<<"$drift") package(s) installed but in no list"
        tr '\n' ' ' <<<"$drift" | fold -s -w 64 | sed 's/^/            /'
        said=1
    fi
    if [ -n "$aur_drift" ]; then
        echo "aur       $(wc -l <<<"$aur_drift") AUR package(s) in no list"
        tr '\n' ' ' <<<"$aur_drift" | fold -s -w 64 | sed 's/^/            /'
        said=1
    fi
    [ "$said" = 0 ] && echo "up to date   ($(dots_host), theme $(dots_theme))"
    return 0
}

case "${1:-}" in
    status)  shift; cmd_status "$@" ;;
    sync)    shift; cmd_sync "$@" ;;
    add)     shift; cmd_add "$@" ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    auth)    shift; cmd_auth "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "dots: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
