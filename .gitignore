dotfiles/hypr/hardware.conf

# Generated by theme/apply.sh from theme/<name>.sh. Untracked because the
# theme is a per-machine choice: tracking these means two machines on
# different themes can never fast-forward, since all eight differ forever.
dotfiles/hypr/colours.conf
dotfiles/hypr/hyprlock.conf
dotfiles/foot/foot.ini
dotfiles/quickshell/Colours.qml
dotfiles/mako/config
dotfiles/tmux/colours.conf
dotfiles/nvim/lua/theme.lua
dotfiles/zathura/zathurarc
dotfiles/newsboat/colors

# Wallpapers live in ~/Pictures/wallpapers, not here: this repo is public
# and should stay small. wall.sh still reads this path if it exists.
wallpapers/
