# newsboat. Colours come from theme/apply.sh, which writes the file included at
# the bottom — so the reader follows the machine's theme like everything else.

auto-reload yes
reload-time 30
reload-threads 6
download-retries 2
download-timeout 15
keep-articles-days 14
max-items 200
prepopulate-query-feeds yes

# Newest first, and mark a feed read from the list rather than opening it.
article-sort-order date-desc
feed-sort-order unreadarticlecount

# vim keys, matching the rest of this setup
bind-key j down
bind-key k up
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key G end
bind-key g home
bind-key l open
bind-key h quit

# o opens in Firefox, and gets the reader out of the way first: it floats over
# your work, so opening an article behind it would leave you reading nothing.
browser "news open %u"

# v reads the article in the terminal, via Firefox's Reader View as a command
# line tool. Most feeds here carry only a 100-500 character teaser — that is
# the publisher driving traffic to their site, not a setting — so without this
# almost everything needs the browser.
#
# bind rather than macro: a macro can only be reached through the macro-prefix
# (",v"), and plain v is newsboat's own view-dialogs — which is what you get
# instead, a list of open dialogs. bind also scopes the key to the two dialogs
# where it means anything, so it cannot fire on the feed list, where the
# selection is the publication's front page rather than an article.
#
# Needs: rdrview (AUR) and w3m.
# news-read does the extraction and the rendering itself rather than chaining
# rdrview -B into w3m. Two reasons, both of which showed up as newsboat simply
# sitting there: rdrview's -B path opens /dev/tty, and rdrview has no timeout,
# so a slow or blocked page hangs with nothing on screen to say why.
bind v articlelist,article set browser "news-read %u" ; open-in-browser ; set browser "news open %u" -- "Read here"

# Readable article view rather than raw HTML.
text-width 100
html-renderer "internal"

include "~/.config/newsboat/colors"
