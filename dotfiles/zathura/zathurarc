set font "JetBrainsMono Nerd Font 11"
set default-bg "#282828"
set default-fg "#ebdbb2"
set statusbar-bg "#1d2021"
set statusbar-fg "#ebdbb2"
set inputbar-bg "#1d2021"
set inputbar-fg "#ebdbb2"
set completion-bg "#3c3836"
set completion-fg "#ebdbb2"
set completion-highlight-bg "#fe8019"
set completion-highlight-fg "#282828"
set index-bg "#282828"
set index-fg "#ebdbb2"
set index-active-bg "#fe8019"
set index-active-fg "#282828"
set highlight-color "rgba(250,189,47,0.5)"
set recolor true
set recolor-lightcolor "#282828"
set recolor-darkcolor "#ebdbb2"
set recolor-keephue true
set selection-clipboard clipboard
set adjust-open "best-fit"
set guioptions ""
map r recolor
