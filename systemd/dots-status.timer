[Unit]
Description=Check the dots repo every half hour

[Timer]
# OnStartupSec, not OnBootSec: in a per-user manager boot is long before login,
# and a monotonic timer whose moment has already passed is skipped, not fired.
OnStartupSec=2min
OnUnitActiveSec=30min
# Catch up after the machine has been asleep, which is the laptop's normal day.
Persistent=true

[Install]
WantedBy=timers.target
